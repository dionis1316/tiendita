digraph password_reset {
  rankdir=TB;
  node [shape=box, style=rounded];
  request [label="/forgot"];
  token [label="Crear token + expires"];
  email [label="Enviar email"];
  open [label="/reset/{token}"];
  validate [label="Validar token"];
  update [label="Actualizar password_hash"];
  done [label="Login"];

  request -> token -> email -> open -> validate -> update -> done;
}
